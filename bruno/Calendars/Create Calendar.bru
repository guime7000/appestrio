meta {
  name: Create Calendar
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/calendars/
  body: json
  auth: none
}

body:json {
  {
    "label": "Calendar A",
    "presets": {
      "setup1": { "start_time": "09:15", "end_time": "19:00" },
      "exception": { "start_time": "10:15", "end_time": "11:30" }
    },
    "days": {
      "lundi": "setup1",
      "mardi": "setup1",
      "mercredi": "exception",
      "jeudi": "exception",
      "vendredi": "setup1",
      "samedi": "setup1",
      "dimanche": "exception"
    }
  }
}

script:post-response {
  if (res.body && res.body.uuid) {
    bru.setVar("calendarUuid", res.body.uuid);
  }
}
