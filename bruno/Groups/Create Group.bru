meta {
  name: Create Group
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/groups/
  body: json
  auth: none
}

body:json {
  {
    "label": "group A",
    "calendar_id": "{{calendarUuid}}"
  }
}

script:post-response {
  if (res.body && res.body.uuid) {
    bru.setVar("groupUuid", res.body.uuid);
  }
}
